[app]
pexels_api_keys = "YOUR_PEXELS_API_KEY"
pixabay_api_keys = []
coverr_api_keys = []
openai_api_key = "YOUR_GEMINI_API_KEY"
openai_base_url = "https://generativelanguage.googleapis.com/v1beta/openai/"
openai_model = "gemini-2.0-flash"
llm_provider = "Google Gemini"
video_codec = "h264_nvenc"

[whisper]
model_size = "medium"
device = "cuda"
compute_type = "float32"

[storytelling]
# Tỷ lệ ảnh: "16:9" | "9:16" | "1:1"
aspect_ratio = "16:9"
# Kích thước sinh ảnh (SD1.5 train ở ~512px — cạnh dài <=768 tránh lặp nhân vật)
image_width  = 768
image_height = 432
# Upscaler (BẮT BUỘC bật để ảnh xuất nét — tắt là chỉ resize thường, ảnh mờ)
enable_upscaling = true
upscaler_model   = "RealESRGAN_x4plus_anime_6B"
# Output video
output_width   = 1920
output_height  = 1080
video_fps      = 24
# Subtitle
subtitle_font      = "Arial"
subtitle_font_size = 28
subtitle_color     = "white"
subtitle_border    = 2
subtitle_position  = "bottom"
# Tham số sinh ảnh (bộ cân bằng tốc độ/chất lượng đã tinh chỉnh 07/2026:
# 8 steps + guidance 5.0 tự kích hoạt Hyper-SD CFG-lora, ~3x nhanh hơn 25 steps)
num_inference_steps = 8
guidance_scale      = 5.0
# Phần cứng: "auto" | "cuda_high" (GPU >=8GB hoặc 6GB muốn tối đa tốc độ) | "cuda_low" | "cpu"
hardware_profile = "auto"
# Identity nhân vật: "clip" (IP-Adapter Plus Face — anime/manhwa, khuyên dùng) | "faceid" (mặt người thật)
identity_engine = "clip"
# Mức độ giống nhân vật theo ảnh tham chiếu (0.5-0.7 khuyên dùng)
ip_adapter_scale = 0.6
# Face Detailer: tự vẽ lại mặt nhỏ/méo sau khi sinh (có cổng kiểm định tự vứt mặt hỏng)
enable_face_detailer   = true
face_detailer_strength = 0.45

# ---------------------------------------------------------------------------
# STYLE LOCK — khóa phong cách ở mức TRỌNG SỐ (không chỉ mức prompt).
# Train bằng: scripts/train_style_lora.py --style thuy_mac --images_dir <dataset>
# Kết quả nằm ở resource/style_loras/<ten>.safetensors. Rỗng = chỉ khóa bằng prompt.
# ---------------------------------------------------------------------------
style_lora        = ""
style_lora_weight = 0.8
# Trọng số cụm hành động đặt ở đầu prompt (1.25-1.45; cao quá dễ méo giải phẫu)
studio_action_weight = 1.35

# ---------------------------------------------------------------------------
# UNIFY PASS (render_mode = "studio") — img2img strength thấp trên frame ĐÃ ghép
# để nhân vật ăn sáng với nền, hết vẻ "dán sticker". Số bước thật = steps*strength.
# ---------------------------------------------------------------------------
studio_unify_pass     = true
studio_unify_strength = 0.28
studio_unify_steps    = 16
studio_unify_guidance = 5.0

